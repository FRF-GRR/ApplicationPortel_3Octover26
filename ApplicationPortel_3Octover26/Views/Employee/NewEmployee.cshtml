@model ApplicationPortel_3Octover26.Models.tblEmployee
@{
    ViewBag.Title = "NewEmployee";
}
<h2>NewEmployee</h2>

@using (Html.BeginForm("NewEmployee", "Employee", FormMethod.Post))
{
   <table>
       <tr>
           <td>Employee Name</td>
           <td>@Html.EditorFor(model => model.EmployeeName)</td>
       </tr>
       <tr>
           <td>Employee Email</td>
           <td>@Html.EditorFor(model => model.EmployeeEmail)</td>
       </tr>
       <tr>
           <td>Employee Password</td>
           <td>@Html.EditorFor(model => model.EmployeePassword)</td>
       </tr>
       <tr>
           <td>Employee Resume</td>
           <td>@Html.EditorFor(model => model.EmployeeResume)</td>
       </tr>
       <tr>
           <td></td>
           <td><input type="submit" value="Submit" /></td>
       </tr>
   </table>
}
