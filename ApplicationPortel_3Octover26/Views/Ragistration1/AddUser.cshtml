@model ApplicationPortel_3Octover26.Models.AddRagisAndCollection

@{
    ViewBag.Title = "AddUser";
}

<h2>AddUser</h2>

@using (Html.BeginForm("AddUser", "Ragistration1", FormMethod.Post, new { enctype = "multipart/form-data"} ))
{
@Html.AntiForgeryToken()

<div class="form-horizontal">
    <h4>tblRegis1</h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.RId)
    @Html.HiddenFor(m=>m.RResume)

    <div class="form-group">
        @Html.LabelFor(model => model.RName, "Name", new { @class = "control-label col-sm-3" })
        <div class="col-sm-9">
            @Html.TextBoxFor(model => model.RName, new { @class = "form-control", placeholder = "Enter Name" })
            @Html.ValidationMessageFor(model => model.RName, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.REmail, "Email", new { @class = "control-label col-sm-3" })
        <div class="col-sm-9">
            @Html.TextBoxFor(model => model.REmail, new { @class = "form-control", type = "email", placeholder = "Enter Email" })
            @Html.ValidationMessageFor(model => model.REmail, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.RPassword, "Password", new { @class = "control-label col-sm-3" })
        <div class="col-sm-9">
            @Html.PasswordFor(model => model.RPassword, new { @class = "form-control", placeholder = "Enter Password" })
            @Html.ValidationMessageFor(model => model.RPassword, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.RMobile, "Mobile", new { @class = "control-label col-sm-3" })
        <div class="col-sm-9">
            @Html.TextBoxFor(model => model.RMobile, new { @class = "form-control", type = "tel", placeholder = "Enter Mobile" })
            @Html.ValidationMessageFor(model => model.RMobile, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.RDob, "Date of Birth", new { @class = "control-label col-sm-3" })
        <div class="col-sm-9">
            @Html.TextBoxFor(model => model.RDob, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            @Html.ValidationMessageFor(model => model.RDob, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.RAge, "Age", new { @class = "control-label col-sm-3" })
        <div class="col-sm-9">
            @Html.TextBoxFor(model => model.RAge, new { @class = "form-control", type = "number", placeholder = "Enter Age" })
            @Html.ValidationMessageFor(model => model.RAge, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.RDepartment, "Department", new { @class = "control-label col-sm-3" })
        <div class="col-sm-9">
            @Html.DropDownListFor(model => model.RDepartment, new SelectList(Model.listdepartments, "DepartmentId", "DepartmentName"), "-- Select Department --", new { @class = "form-control " })
            @Html.ValidationMessageFor(model => model.RDepartment, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.RGender, "Gender", new { @class = "control-label col-sm-3" })
        <div class="col-sm-9">
            @foreach (var gender in Model.listgenders)
            {
                @Html.RadioButtonFor(model => model.RGender, gender.GenderId)
                @gender.GenderName
                //in mvc no radiobuttonlist ,it only radioButton then use perform foreach loop
                <text>&nbsp;&nbsp;</text>
            }
            @Html.ValidationMessageFor(model => model.RGender, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.RHobbies, "Hobbies", new { @class = "control-label col-sm-3" })
        <div class="col-sm-9">
            @for (var i = 0; i < Model.listhobbies.Count; i++)
            {
                @Html.CheckBoxFor(model => model.listhobbies[i].ischeked)
                @Model.listhobbies[i].HobbiesName
                @Html.HiddenFor(model =>model.listhobbies[i].HobbiesName)

                <text>&nbsp;&nbsp;</text>
            }
            @Html.ValidationMessageFor(model => model.RHobbies, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.RCountry, "Country", new { @class = "control-label col-sm-3" })
        <div class="col-sm-9">
            @Html.DropDownListFor(model => model.RCountry, new SelectList(Model.listcountries, "CountryId", "CountryName"), "--Select Country--", new { @class = "form-control", onchange = "StateBind()" })
            @Html.ValidationMessageFor(model => model.RCountry, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.RState, "State", new { @class = "control-label col-sm-3" })
        <div class="col-sm-9">
            @Html.DropDownListFor(model => model.RState, new SelectList(Model.liststate, "StateId", "StateName"), "--Select State--", new { @class = "form-control", onchange = "BindCity()" })
            @Html.ValidationMessageFor(model => model.RState, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.RCity, "City", new { @class = "control-label col-sm-3" })
        <div class="col-sm-9">
            @Html.DropDownListFor(model => model.RCity, new SelectList(Model.listcity, "CityId", "CityName"), "--Select City--", new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.RCity, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.RResume, "Resume", new { @class = "control-label col-sm-3" })
        <div class="col-sm-9">
           <input type="file" name="ResumeFile" />
        </div>
    </div>

    <div class="form-group">
        <div class="col-sm-offset-3 col-sm-9">
            <input type="submit" value="@ViewBag.BTN" class="btn btn-primary btn-block-xs" />
        </div>
    </div>
</div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script type="text/javascript">

        //Bind State
function StateBind() {
   $.ajax({
    url: '@Url.Action("BindState","Ragistration1")',
    type: 'POST',
    data: { A: $("#RCountry").val() },
    success: function (data) {
        $("#RState").empty();
        $("#RState").append($('<option></option>').html("--Select State--").val("0"));
        for (var i = 0; i < data.length; i++) {
            $("#RState").append($('<option></option>').html(data[i].StateName).val(data[i].StateId));
        }
    },
    error: function () {
        alert("State not Bind");
    }
});

    }
//Bind City
   function BindCity() {
    $.ajax({
        url: '@Url.Action("BindCity","Ragistration1")',
        type: 'POST',
        data: { B: $("#RState").val() },   
        success: function (data) {
            $("#RCity").empty();
            $("#RCity").append($('<option></option>').html("--Select City--").val("0"));
            for (var i = 0; i < data.length; i++) {
                $("#RCity").append($('<option></option>').html(data[i].CityName).val(data[i].CityId));
            }
        },
        error: function () {
            alert("City not Bind");
        }
    });
}




    </script>
}